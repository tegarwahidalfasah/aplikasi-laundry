// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Order {
  id           Int      @id @default(autoincrement())
  customerName String
  phoneNumber  String?  // Kolom baru untuk fitur notifikasi WhatsApp
  serviceType  String   @default("Cuci Lipat")
  weight       Float
  totalPrice   Float
  status       String   @default("Antri")
  createdAt    DateTime @default(now())
}